        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;graph TD\n    classDef startEnd fill:#ECEFF1,stroke:#607D8B,stroke-width:2px,rx:20,ry:20;\n    classDef decision fill:#FFF9C4,stroke:#FBC02D,stroke-width:2px;\n    classDef action fill:#E8F5E9,stroke:#43A047,stroke-width:2px;\n    classDef stateChange fill:#E3F2FD,stroke:#1E88E5,stroke-width:2px,font-weight:bold;\n\n    Start((\&quot;Start Clock Cycle&lt;br&gt;(State = PROCESSING)\&quot;)):::startEnd --&gt; CheckInput{\&quot;input_en == 1?\&quot;}:::decision\n\n    %% ------------------------------------------------\n    %% LEFT PATH: Input Disabled (Disconnecting)\n    %% ------------------------------------------------\n    CheckInput --&gt;|No| CheckFlush{\&quot;flush_count == 0?\&quot;}:::decision\n    \n    CheckFlush --&gt;|Yes| GoIdle[\&quot;Next State: IDLE&lt;br&gt;butterfly_en = 0\&quot;]:::stateChange\n    CheckFlush --&gt;|No| GoFlush[\&quot;Next State: FLUSH&lt;br&gt;butterfly_en = 1\&quot;]:::stateChange\n    \n    GoIdle --&gt; UpdateCountersOff[\&quot;Inc butterfly_counter&lt;br&gt;Dec flush_count&lt;br&gt;(Hold all other counters)\&quot;]:::action\n    GoFlush --&gt; UpdateCountersOff\n\n    UpdateCountersOff --&gt; EndCycle\n\n    %% ------------------------------------------------\n    %% RIGHT PATH: Input Active (Streaming)\n    %% ------------------------------------------------\n    CheckInput --&gt;|Yes| ActiveBase[\&quot;butterfly_en = 1&lt;br&gt;Inc input_count&lt;br&gt;Dec flush_count\&quot;]:::action\n    \n    ActiveBase --&gt; CheckStepMode{\&quot;step_mode_input == 0?\&quot;}:::decision\n    \n    %% Step Mode Logic\n    CheckStepMode --&gt;|Yes| NormalStep[\&quot;Toggle step_mode_in&lt;br&gt;if stride_counter = MAX&lt;br&gt;---&lt;br&gt;Toggle step_mode_out&lt;br&gt;if butterfly_counter = MAX\&quot;]:::action\n    CheckStepMode --&gt;|No| AltStep[\&quot;Hold step_mode_in&lt;br&gt;---&lt;br&gt;Clear step_mode_out&lt;br&gt;if butterfly_counter = MAX\&quot;]:::action\n    \n    NormalStep --&gt; CheckStrideMax\n    AltStep --&gt; CheckStrideMax\n    \n    %% Counter Wraparound Logic (Stride)\n    CheckStrideMax{\&quot;stride_counter = MAX&lt;br&gt;AND&lt;br&gt;step_mode_in = 1?\&quot;}:::decision\n    CheckStrideMax --&gt;|Yes| StrideXOR[\&quot;stride_counter =&lt;br&gt;XOR Wrap (Reset lower bits)\&quot;]:::action\n    CheckStrideMax --&gt;|No| StrideInc[\&quot;Inc stride_counter\&quot;]:::action\n    \n    StrideXOR --&gt; CheckButterflyMax\n    StrideInc --&gt; CheckButterflyMax\n    \n    %% Counter Wraparound Logic (Butterfly)\n    CheckButterflyMax{\&quot;butterfly_counter = MAX&lt;br&gt;AND&lt;br&gt;step_mode_out = 1?\&quot;}:::decision\n    CheckButterflyMax --&gt;|Yes| ButterflyXOR[\&quot;butterfly_counter =&lt;br&gt;XOR Wrap (Reset lower bits)\&quot;]:::action\n    CheckButterflyMax --&gt;|No| ButterflyInc[\&quot;Inc butterfly_counter\&quot;]:::action\n    \n    ButterflyXOR --&gt; EndCycle\n    ButterflyInc --&gt; EndCycle\n\n    EndCycle((\&quot;End Clock Cycle\&quot;)):::startEnd&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="phXvzpiJET0qV9rinY_D-43">
